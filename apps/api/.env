ENV=development

# DATABASE
DATABASE_URL=postgres://postgres:rahasia@localhost:5432/tag_me
PORT=8080

# JWT
JWT_SECRET_KEY=your_secret_key_here
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRY_SECONDS=168 # 7 days in hours


# OTP

# OTP_MAX_REQUEST_ATTEMPTS
# Max OTP code requests per hour (rate limiting)
# Tracks consecutive request attempts to prevent abuse
OTP_MAX_REQUEST_ATTEMPTS=5

# OTP_TTL
# TTL in seconds for the `otp_request` Redis key
# Determines how long an OTP code remains valid after initial request
# Used in Redis operations: SET otp_request:{user_id} {code} EX {OTP_TTL}
OTP_TTL=180 # 3 minutes

# OTP_VERIFY_CODE_TTL
# TTL in seconds for the `otp_verify` Redis keys created during InitVerifyOTPRedis and IncrVerifyOTPAttempt function
# Controls the expiration window for OTP verification attempt data
# Defines how long verification context is stored before automatic cleanup
OTP_VERIFY_CODE_TTL=180 # 3 minutes

# OTP_ATTEMPT_TTL
# TTL in seconds for the `IncrOTPRequestCount` Redis counter key
# Tracks consecutive OTP request attempts for rate limiting and account locking
# Counter resets after this period of inactivity to allow fresh request cycles
OTP_ATTEMPT_TTL=3600 # 1 hour

# OTP_MAX_ATTEMPTS
# Max OTP attempts before blocking further requests
OTP_MAX_VERIFY_ATTEMPTS=3


# Redis
REDIS_URL=redis://localhost:6379

# Message
MESSAGE_MAX_PER_SESSION_QR=5
CONVERSATION_CREATION_COOLDOWN_SECONDS=60

# Reminder
REMINDER_COOLDOWN_SECONDS=30
REMINDER_MAX_ATTEMPTS=3
REMINDER_IP_WINDOW_LIMIT=10
