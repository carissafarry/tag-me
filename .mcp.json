{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context=claude-code",
        "--project",
        "/Users/carissafarry/Documents/Projects/Personal/tag-me"
      ],
      "env": {}
    },
    "code-review-graph": {
      "command": "uvx",
      "args": ["code-review-graph", "serve"],
      "type": "stdio"
    },
    "token-savior-recall": {
      "command": "/Users/carissafarry/.local/bin/token-savior",
      "env": {
        "WORKSPACE_ROOTS": "/Users/carissafarry/Documents/Projects/Personal/tag-me",
        "TOKEN_SAVIOR_CLIENT": "claude-code"
      }
    }
  }
}
